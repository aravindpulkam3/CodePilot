{
  "name": "ai-engineering-workspace-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "test": "node --import tsx --test src/**/*.test.ts",
    "parsers:sync": "node scripts/syncParsers.mjs",
    "parsers:verify": "node scripts/verifyParsers.mjs"
  },
  "dependencies": {
    "@bull-board/api": "^9.5.0",
    "@bull-board/express": "^9.5.0",
    "@clerk/express": "^1.3.5",
    "@google/genai": "^2.15.0",
    "axios": "^1.16.1",
    "bullmq": "^6.3.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "ioredis": "^6.0.0",
    "ollama": "^0.6.3",
    "pg": "^8.13.0",
    "rate-limiter-flexible": "^11.2.0",
    "svix": "^1.36.0",
    "web-tree-sitter": "^0.26.11"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.5",
    "@types/pg": "^8.11.10",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
